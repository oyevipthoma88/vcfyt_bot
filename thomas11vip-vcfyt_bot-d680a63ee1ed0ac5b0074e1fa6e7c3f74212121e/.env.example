# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values (for local testing only).
# On Heroku, set these as Config Vars in the dashboard / via CLI.
# DO NOT commit your real .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
# Telegram API credentials — https://my.telegram.org
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Bot token from @BotFather
BOT_TOKEN=1234567890:ABCDefGhijKLMnopQRSTuvwxyz

# Your numeric Telegram user ID (get from @userinfobot)
OWNER_ID=987654321

# Log channel ID. Pre-set to -1004303404961 in config.py — override only if needed.
# Bot ko is channel/group mein admin banayein.
LOG_CHANNEL=-1004303404961

# ── Recommended ───────────────────────────────────────────────────────────────
# Pyrogram string session for the userbot (VC account)
# Generate at: https://t.me/Session_generator_1bot  (ya bot mein /login karein)
STRING_SESSION=BQABAgAD...your_session_here...

# MongoDB Atlas URI (free tier — persistent storage across Heroku dyno restarts)
# Get from: https://www.mongodb.com/atlas/database
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/vcbot?retryWrites=true&w=majority

# ── Optional / Defaults ───────────────────────────────────────────────────────
# Volume multiplier (default 1000x — 1000x amplitude with heavy compression)
DEFAULT_VOLUME=1000

# Bass boost in dB (0-60, default 35 dB)
DEFAULT_BASS=25

# Echo effect on by default (true/false)
DEFAULT_ECHO=true

# Your Heroku app name
HEROKU_APP_NAME=my-vc-audio-bot

# Echo strength 0-10 (default 6)
DEFAULT_ECHO_LEVEL=6

# Loudness boost stage 0-10 (default 8)
DEFAULT_BOOST=8

# Live mic boost applied automatically to logged-in accounts (1-20000)
LIVE_BOOST_DEFAULT=20000
AUTO_LIVE_BOOST=true
